<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="mageme" translate="label" sortOrder="500" class="mageme-extensions">
            <label>MageMe Extensions</label>
        </tab>
        <section id="mageme" translate="label" type="text" sortOrder="500" showInDefault="1">
            <label>MageMe</label>
            <tab>mageme</tab>
            <resource>MageMe_Core::network_settings</resource>
            <group id="feed" translate="label" type="text" sortOrder="10" showInDefault="0">
                <label>News Feed</label>
                <field id="send_modules" translate="label" type="select" sortOrder="10" showInDefault="0">
                    <label>Report Installed Extensions</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="network" translate="label" type="text" sortOrder="20" showInDefault="1">
                <label>Network</label>
                <field id="trusted_proxies" translate="label comment" type="textarea" sortOrder="10" showInDefault="1">
                    <label>Trusted Proxies</label>
                    <comment>IP addresses or CIDR ranges of your proxies (load balancer, Varnish, Cloudflare), one per line. When filled, the visitor IP is taken from X-Forwarded-For only for requests that come through these proxies, so visitors cannot set it with their own headers. Empty: forwarded headers are read from any request.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
