<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MageMe\Core\Config\Feed">
        <plugin name="mageme_core_feed_installation_profile"
                type="MageMe\Core\Plugin\Config\FeedUrl"/>
    </type>

    <!--
        Magento shares one Curl instance across everything that injects it, and cURL options set on it
        persist for the rest of the request. Our callers set timeouts, a User-Agent and disable redirect
        following; on a shared client those would apply to unrelated consumers, and theirs to ours.
        Each gets its own non-shared client instead.
    -->
    <virtualType name="MageMeCoreHttpClient" type="Magento\Framework\HTTP\Client\Curl" shared="false"/>
    <type name="MageMe\Core\Helper\GenericLicenseHelper">
        <arguments>
            <argument name="curl" xsi:type="object">MageMeCoreHttpClient</argument>
        </arguments>
    </type>
    <type name="MageMe\Core\Helper\LicenseHelper">
        <arguments>
            <argument name="curl" xsi:type="object">MageMeCoreHttpClient</argument>
        </arguments>
    </type>
    <preference for="MageMe\Core\Api\LicenseCoverageInterface" type="MageMe\Core\Model\License\VersionCoverage"/>
    <preference for="MageMe\Core\Api\DevelopmentHostInterface" type="MageMe\Core\Model\License\DevelopmentHost"/>
    <virtualType name="MageMeCoreRemoteAddress" type="Magento\Framework\HTTP\PhpEnvironment\RemoteAddress">
        <arguments>
            <argument name="alternativeHeaders" xsi:type="array">
                <item name="cf-connecting-ip" xsi:type="string">HTTP_CF_CONNECTING_IP</item>
                <item name="x-forwarded-for" xsi:type="string">HTTP_X_FORWARDED_FOR</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="MageMe\Core\Helper\NetworkHelper">
        <arguments>
            <argument name="remoteAddress" xsi:type="object">MageMeCoreRemoteAddress</argument>
        </arguments>
    </type>
    <type name="MageMe\Core\Model\ModuleEcosystem\RemoteCatalog">
        <arguments>
            <argument name="curl" xsi:type="object">MageMeCoreHttpClient</argument>
        </arguments>
    </type>
</config>
